{
    "name": "fov-backend",
    "version": "0.1.0",
    "description": "FOV backend (Express)",
    "type": "module",
    "main": "src/index.js",
    "scripts": {
        "start": "node src/index.js",
        "dev": "nodemon src/index.js",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
        "test:watch": "jest --watch",
        "lint": "eslint src/ --ext .js,.mjs",
        "lint:fix": "eslint src/ --ext .js,.mjs --fix"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.0.0",
        "express": "^4.22.1",
        "morgan": "^1.10.0",
        "mysql2": "^3.6.5",
        "node-av": "^5.0.3",
        "node-fetch": "^3.3.2",
        "node-media-server": "2.2.0",
        "pg": "^8.23.0",
        "srt": "^0.0.3",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "@types/pg": "^8.23.1",
        "eslint": "^8.56.0",
        "jest": "^29.7.0",
        "jest-mock-extended": "^3.0.5",
        "nodemon": "^3.1.11",
        "supertest": "^6.3.3"
    }
}
